{
  "name": "dsh-ssh-remote",
  "version": "1.4.1",
  "description": "SSH remote development for DeepSeek Harness: manage SSH machines in Settings, browse remote directories, register remote workspaces, and let the agent run commands and edit files over SSH.",
  "license": "MIT",
  "author": {
    "name": "ShangyuLei-HIT",
    "url": "https://github.com/ShangyuLei-HIT"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShangyuLei-HIT/dsh-ssh-remote.git"
  },
  "homepage": "https://github.com/ShangyuLei-HIT/dsh-ssh-remote#readme",
  "bugs": {
    "url": "https://github.com/ShangyuLei-HIT/dsh-ssh-remote/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "ssh",
    "remote",
    "development",
    "agent",
    "remote-workspace"
  ],
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "selftest:offline": "node scripts/selftest.mjs --offline",
    "selftest:ssh": "node scripts/selftest.mjs --ssh",
    "selftest:client": "node scripts/client-selftest.mjs",
    "selftest:all": "node scripts/selftest.mjs --offline && node scripts/client-selftest.mjs",
    "market:index": "node scripts/make-index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "engines": {
      "dsh": ">=0.2.2-0 <0.3.0"
    }
  }
}
